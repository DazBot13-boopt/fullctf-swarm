# Image "fat" FullCTF Swarm : TOUT l'arsenal CTF en un seul build.
#
# Build :
#   docker build -f infrastructure/Dockerfile.arsenal -t fullctf-arsenal:latest .
#
# ⚠️ Image VOLUMINEUSE (plusieurs Go) et build LONG (Ghidra + SageMath + angr...).
#    C'est normal : on installe tout d'un coup pour que les missions démarrent
#    instantanément ensuite. Prévoir du disque (>15 Go) et du temps (20-40 min).
#
# Astuce VPS : lance le build dans tmux pour ne pas perdre la session.
#
# Robustesse (Sprint 0) : chaque catégorie s'installe PAQUET PAR PAQUET. Un paquet
# indisponible dans les dépôts (ex. sagemath absent ce jour-là) est SAUTÉ et
# n'annule plus toute la catégorie. Les skips sont visibles dans le log ("SKIP ...").
# Prérequis hôte : net.ipv4.ip_forward=1 (sinon les conteneurs n'ont pas de réseau).

FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
SHELL ["/bin/bash", "-c"]

# --- Base système + toolchains (étape critique : PAS de || true, elle doit réussir) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev pipx \
    git curl wget ca-certificates unzip p7zip-full \
    build-essential gcc-multilib \
    ruby ruby-dev \
    default-jdk \
    file xxd \
    && rm -rf /var/lib/apt/lists/*

# --- Arsenal via apt (dépôts Kali) : web, pwn, reverse, forensic, réseau, cracking.
#     Installé paquet par paquet => un paquet manquant ne casse pas les autres. ---
RUN apt-get update && for p in \
      ffuf sqlmap feroxbuster nikto whatweb wfuzz \
      gdb gdb-multiarch radare2 ltrace strace patchelf pwndbg \
      python3-pwntools \
      python3-fpylll \
      ghidra \
      binwalk foremost exiftool steghide outguess \
      sleuthkit testdisk \
      tshark tcpdump nmap \
      john hashcat hydra \
      stegsnow ; do \
        apt-get install -y --no-install-recommends "$p" || echo "SKIP apt: $p" ; \
      done ; \
    rm -rf /var/lib/apt/lists/*

# --- SageMath : volumineux et parfois absent des dépôts. Étape isolée et tolérante
#     pour ne jamais bloquer le reste de l'arsenal crypto (z3/sympy/pycryptodome). ---
RUN apt-get update \
    && (apt-get install -y --no-install-recommends sagemath \
        || echo "SKIP sagemath (indisponible via apt ce jour-là)") ; \
    rm -rf /var/lib/apt/lists/*

# --- Arsenal Python (image dédiée => --break-system-packages sans risque).
#     Install paquet par paquet : résilient aux indisponibilités PyPI. ---
# Note : pwntools s'installe via apt (python3-pwntools, plus fiable que pip).
RUN for p in \
      angr \
      z3-solver \
      ROPGadget \
      ropper \
      pycryptodome \
      sympy \
      gmpy2 \
      requests \
      volatility3 \
      capstone unicorn keystone-engine \
      qiling \
      scapy \
      mitmproxy ; do \
        pip3 install --no-cache-dir --break-system-packages "$p" || echo "SKIP pip: $p" ; \
      done

# --- Playwright (web dynamique / XSS / JS) + navigateur Chromium ---
RUN pip3 install --no-cache-dir --break-system-packages playwright \
    && python3 -m playwright install --with-deps chromium \
    || echo "SKIP playwright"

# --- Outils Ruby : zsteg (stégano PNG) + one_gadget (pwn, gem plus fiable que pip) ---
RUN for g in zsteg one_gadget ; do \
      gem install --no-document "$g" || echo "SKIP gem: $g" ; \
    done

# --- pwndbg : init pour GDB (tolérant si pwndbg absent) ---
RUN PD=$(python3 -c 'import pwndbg,os;print(os.path.dirname(pwndbg.__file__))' 2>/dev/null) \
    && [ -n "$PD" ] && echo "source $PD/gdbinit.py" > /root/.gdbinit \
    || echo "SKIP pwndbg gdbinit"

# --- RsaCtfTool (git ; désormais packagé pyproject/src -> install pip propre,
#     fournit la commande `RsaCtfTool`) ---
RUN git clone --depth 1 https://github.com/RsaCtfTool/RsaCtfTool.git /opt/RsaCtfTool \
    && pip3 install --no-cache-dir --break-system-packages /opt/RsaCtfTool \
    || echo "SKIP RsaCtfTool"

# --- Ghidra headless : le binaire est dans /usr/share/ghidra/support. On met un
#     symlink dans /usr/local/bin pour qu'`analyzeHeadless` soit TOUJOURS sur le
#     PATH (un shell de login recharge le PATH et perdrait un simple ENV). ---
ENV PATH="/usr/share/ghidra/support:${PATH}"
RUN ln -sf /usr/share/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless \
    2>/dev/null || echo "SKIP ghidra symlink"

WORKDIR /work
CMD ["/bin/bash"]

# Vérification rapide après build (optionnel) :
#   docker run --rm fullctf-arsenal:latest bash -lc \
#     "python3 -c 'import pwn,angr,z3' && ffuf -V && gdb --version | head -1"
#
# Note runtime (pas un souci de build) : nmap et les outils à sockets bruts ont
# des capabilities (cap_net_raw). Pour qu'ils fonctionnent, lancer le conteneur de
# mission avec les droits réseau, p.ex. :
#   docker run --cap-add=NET_RAW --cap-add=NET_ADMIN ... fullctf-arsenal:latest
# (cohérent avec la policy "liberté totale DANS le conteneur jetable").
